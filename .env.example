APP_NAME=DeskPilot AI
APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX_NAME=deskpilot-it-support
PINECONE_NAMESPACE=company-it-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
INDEX_READY_TIMEOUT_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=30
TOP_K=4
MAX_RETRIES=1
# Both this setting and request allow_web=true are needed for public search.
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=
# Empty disables ingestion. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_API_KEY=
MAX_UPLOAD_BYTES=10485760
AUDIT_STORE_QUESTIONS=false
